language = "python3"

run = "cd backend && pip install -r requirements.txt && python -m playwright install chromium && uvicorn app.main:app --host 0.0.0.0 --port 8080"

[nix]
channel = "stable-24_05"

[deployment]
run = ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
workingDirectory = "backend"

[[ports]]
localPort = 8080
externalPort = 80
